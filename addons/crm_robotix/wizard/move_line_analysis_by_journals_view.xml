<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <!-- Asistente -->
        <record id="view_move_line_analysis_wizard_form" model="ir.ui.view">
            <field name="name">move.line.analysis.wizard.form</field>
            <field name="model">move.line.analysis.wizard</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">
                <form string="Análisis de Lineas de Facturas" reate="false" edit="false">
                    <sheet >
                        <separator colspan="4" string="Presiona el boton para Generar el Reporte"/>
                        <group>
                            <field name="start_date" required="1"/>
                            <field name="end_date" required="1"/>
                            <field name="company_ids" options="{'no_create':True,'no_create_edit':True}" required="1" widget="many2many_tags"/>
                        </group>
                        
                    </sheet>
                    <footer>
                        <center>
                            <button name="execute_report" string="Generar" type="object" icon="fa-file-excel-o"/>
                            o
                            <button string="Cancelar" class="oe_link" special="cancel" icon="fa-window-close"/>
                        </center>
                    </footer>


                </form>
            </field>
        </record>



    <!-- ACCION PARA WIZARD -->
    <record id="action_move_line_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Análisis de Lineas de Facturas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">move.line.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_move_line_analysis_wizard_form"/>
        <field name="target">new</field>
        <!-- <field name="binding_model_id" ref="purchase.model_purchase_order"/> -->
    </record>

    <menuitem name="Análisis de Lineas de Facturas" action="action_move_line_analysis_wizard" id="menu_move_line_analysis_wizard" parent="account_menu_reports_cava.account_cava_wizard_menu_root" sequence="1"/>


    <!-- Herencia  Partner -->

    <record id="res_partner_report_analysis_extension_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Comercial">
                    <group>
                        <group>
                            <field name="plan_hotel_id" />
                            <field name="partner_group_id" />
                            <field name="is_driver" widget="boolean_toggle"/>
                            <field name="driver_id" attrs="{'invisible':[('is_driver','=',False)],'required':[('is_driver','=',True)]}" options="{'no_create':True,'no_create_edit':True}"/>
                            <field name="is_salesman_manager" widget="boolean_toggle"/>
                            <field name="salesman_id" attrs="{'invisible':[('is_salesman_manager','=',False)],'required':[('is_salesman_manager','=',True)]}" options="{'no_create':True,'no_create_edit':True}"/>
                            <field name="is_salesman_collection" widget="boolean_toggle"/>
                            <field name="collection_id" attrs="{'invisible':[('is_salesman_collection','=',False)],'required':[('is_salesman_collection','=',True)]}" options="{'no_create':True,'no_create_edit':True}"/>
                        </group>
                        <group>
                            <field name="city_operation_work" />
                            <field name="financial_branch_id" />
                            <field name="comercial_channel_id" />
                            <field name="comercial_subchannel_id" />
                            <field name="consumption_segment_id" />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Herencia Diarios -->

    <record id="account_journal_report_analysis_extension_form" model="ir.ui.view">
        <field name="name">account.journal.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                    <field name="report_invoice_line_access" />
            </field>
        </field>
    </record>

