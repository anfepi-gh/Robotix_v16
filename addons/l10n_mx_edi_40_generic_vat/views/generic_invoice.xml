<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Factura -->

        <record  model="ir.ui.view" id="view_move_form_l10n_mx_edi_40_generic_vat">
            <field name="name">account.move.form.l10n_mx_edi_40_generic_vat</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_vendor_bill_id" position="after">
                    <field name="invoice_general_public" attrs="{'invisible': [('l10n_mx_edi_cfdi_request', '=', False)]}"/>
                </field>
                <notebook position="inside">
                    <page name="info_global" string="Factura global"  attrs="{'invisible': [('invoice_general_public','=',False)]}">
                        <group cols="4">
                            <group>
                                <field name="fg_periodicity" attrs="{'readonly':[('l10n_mx_edi_cfdi_uuid','!=',False)]}" force_save="True"/>
                                <field name="fg_months" attrs="{'readonly':[('l10n_mx_edi_cfdi_uuid','!=',False)]}" force_save="True"/>
                                <field name="fg_year" attrs="{'readonly':[('l10n_mx_edi_cfdi_uuid','!=',False)]}" force_save="True"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>


        <!-- Herencia de Objetos y Formularios -->

        <record id="view_partner_public_40_invoice_form" model="ir.ui.view">
            <field name="name">res.partner.public.40.invoice.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <field name="property_account_position_id" position="after" >
                    <field name="contact_general_public"/>
                </field>
            </field>
        </record>


    </data>
</odoo>