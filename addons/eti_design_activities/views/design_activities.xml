<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="eti_design_activity_wizard_form_view" model="ir.ui.view">
        <field name="name">eti.design.activity.wizard.form.view</field>
        <field name="model">design.activities</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="task_type_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="date_deadline"/>
                </group>
                <notebook>
                    <page string="Description" name="description">
                        <field name="description"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_task" string="Create Task" type="object" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- esta acción del binding model siempre va a existir o estar disponible en el modelo de product.product o variantes de producto.
    -->
    <act_window id="eti_design_activity_wizard"
        name="Wizard para generación de actividades"
        binding_model="product.product"
        res_model="design.activities"
        view_mode="form"
        target="new"/>
</odoo>
