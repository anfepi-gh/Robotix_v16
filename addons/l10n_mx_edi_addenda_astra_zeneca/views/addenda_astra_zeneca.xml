<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

<template id="l10n_mx_edi_addenda_astra_zeneca" name="Addenda Astrazeneca">
            <!-- <t t-set="sumary" t-value="record.getAddendaSumary()" /> -->
            <t t-set="sale_model" t-value="'sale_line_ids' in record.invoice_line_ids._fields"/>
            <t t-set="sale_id" t-value="record.mapped('invoice_line_ids.sale_line_ids.order_id') if sale_model else False"/>
            <t t-set="pickings" t-value="sale_id.picking_ids.filtered(lambda x: x.state == 'done' and x.date_done)" />
            <AddendaLineas>
                <t t-foreach="record.invoice_line_ids" t-as="line">
                    <AddendaLinea t-att-NoIdentificacion="line.no_identificacion_astra_zeneca" t-att-NumeroDeDocumentoDeLaOrdenDeCompra="line.move_id.orden_compra_astra_zeneca" t-if="line.product_id"/>
                </t>
            </AddendaLineas>

        </template>

</data>
</odoo>