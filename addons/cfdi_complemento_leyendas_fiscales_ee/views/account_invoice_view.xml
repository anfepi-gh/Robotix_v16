<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view for complemento.leyenda.fiscal (extracted to avoid v19 comodel validation in inherited form) -->
    <record id="complemento_leyenda_fiscal_list_view" model="ir.ui.view">
        <field name="name">complemento.leyenda.fiscal.list</field>
        <field name="model">complemento.leyenda.fiscal</field>
        <field name="arch" type="xml">
            <list string="Leyendas Fiscales">
                <field name="disposicion"/>
                <field name="norma"/>
                <field name="texto_leyenda"/>
            </list>
        </field>
    </record>

    <record id="complemento_leyenda_fiscal_form_view" model="ir.ui.view">
        <field name="name">complemento.leyenda.fiscal.form</field>
        <field name="model">complemento.leyenda.fiscal</field>
        <field name="arch" type="xml">
            <form string="Leyenda Fiscal">
                <group>
                    <field name="disposicion"/>
                    <field name="norma"/>
                    <field name="texto_leyenda"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_invoice_extend_complemento_leyendas_fiscales_ee" model="ir.ui.view">
        <field name="name">account.move.form.leyendas.fiscales</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group//group[last()]" position="inside">
                <field name="complemento_leyendas_fiscales"/>
            </xpath>
            <notebook position="inside">
                <page string="Leyendas Fiscales" invisible="not complemento_leyendas_fiscales">
                    <field name="leyendas_fiscales_ids"/>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
