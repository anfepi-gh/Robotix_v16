<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_account_form" model="ir.ui.view">
        <field name="name">res.partner.account.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="complemento_leyendas_fiscales" />
            </field>
            <notebook position="inside">
                <page string="Leyendas Fiscales" invisible="not complemento_leyendas_fiscales">
                    <field name="leyendas_fiscales_ids"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
